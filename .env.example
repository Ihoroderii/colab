# Tokens (optional)
# HF_TOKEN=your_REMOVED_TOKENor_router_token
# OPENAI_API_KEY=your_openai_key

# Device preference (cuda|cpu)
# DEVICE=cpu

# Scenario controls
# PANELS=4
# GENRE=action
# SETTING="modern city at dusk"
# EPISODE_TITLE="Episode 1: Rooftop Oath"
# TONE=dramatic
# PROTAGONIST=Jin
# ANTAGONIST=Raven

# Export config
# EXPORT=true
# EXPORT_WIDTH=800
# EXPORT_MAX_SLICE_HEIGHT=1280
# EXPORT_OVERLAP=40
# EXPORT_FORMAT=png
# EXPORT_QUALITY=95
# EXPORT_SUBDIR=export
# API Configuration
HF_TOKEN=your_huggingface_token_here
OPENAI_API_KEY=your_openai_api_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_workers_ai_token_here

# Remote image API mode - avoids downloading/running diffusion locally
# IMAGE_BACKEND=api
# IMAGE_API_PROVIDER=cloudflare
# IMAGE_API_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# IMAGE_API_SIZE=1024x1024
# IMAGE_API_QUALITY=medium
# CLOUDFLARE_USE_MULTIPART=true
# USE_BLENDER_CONTROL=true

# Model Selection
SD_MODEL=stabilityai/stable-diffusion-3.5-large
LLM_PROVIDER=cloudflare
LLM_MODEL=@cf/meta/llama-3.1-8b-instruct
BLIP_MODEL=Salesforce/blip-image-captioning-large
CLIP_MODEL=ViT-B/32

# Hardware Settings
DEVICE=cuda  # or cpu
TORCH_DTYPE=float16  # or float32
USE_SAFETY_CHECKER=false

# Generation Parameters
GUIDANCE_SCALE=7.5
NUM_INFERENCE_STEPS=50
MAX_SEQUENCE_LENGTH=77
TEMPERATURE=0.8
MAX_TOKENS=500

# Style Settings
# If AUTO_PANEL_WIDTH=true (default), width is computed from scene/speech with jitter applied
# If AUTO_PANEL_WIDTH=false, PANEL_WIDTH is used as the base and jitter applied around it
AUTO_PANEL_WIDTH=true
AUTO_STYLE=true
PANEL_WIDTH=800
PANEL_GAP=40
PANEL_WIDTH_JITTER=0.15
CANVAS_BG=#111111
FONT_SIZE=24
BOLD_FONT_SIZE=20
FONT_PATH=/usr/share/fonts/truetype/nanum/NanumGothic.ttf

# Style normalization (optional)
STYLE_NORMALIZATION_ENABLED=false
STYLE_REFERENCE_IMAGE=references/manga_style_reference.png
STYLE_NORMALIZATION_WIDTH=768
STYLE_NORMALIZATION_HEIGHT=1024
STYLE_NORMALIZATION_GAMMA=0.96
STYLE_NORMALIZATION_CONTRAST=1.08
STYLE_NORMALIZATION_AUTOCONTRAST_CUTOFF=1
STYLE_NORMALIZATION_GRAIN_STRENGTH=0.02

# Bubble rendering
BUBBLE_BACKEND=manhwa_bubbles
BUBBLE_PROJECT_PATH=../bubble
BUBBLE_USE_YOLO=false
BUBBLE_PREFER_CAIRO=true
BUBBLE_FALLBACK_TO_INTERNAL=true

# Lighting Effects (optional)
# APPLY_DRAMATIC_LIGHTING=false
# LIGHTING_STYLE=dramatic  # dramatic|soft|contrast
# LIGHTING_INTENSITY=0.5   # 0..1

# Output Configuration
OUTPUT_DIR=output
SAVE_INDIVIDUAL_PANELS=true
PANEL_FILENAME_TEMPLATE=panel_{}.png
CHAPTER_FILENAME=manhwa_chapter.png
IMAGE_QUALITY=95

# Debug Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
VERBOSE=false
